# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (Docker Compose uses these; override for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pc_paradis_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (development: console backend logs to stdout; production: set SMTP/Resend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PC Paradis CI <no-reply@pcparadis.ci>

# Platform
PLATFORM_NAME=PC Paradis CI
FRONTEND_URL=http://localhost:5173

# CORS
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (production: DJANGO_SECRET_KEY is required, no fallback)
SHOW_API_DOCS=true

# Production (docs/DEPLOYMENT.md)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# FRONTEND_URL=https://pcparadis.ci

# MFA / Tokens
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
MFA_CODE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5